{
  "id": "mvp-basic",
  "title": "MVP Basic Flow",
  "stages": [
    { "id": "s_input", "name": "输入准备" },
    { "id": "s_llm", "name": "回答生成" },
    { "id": "s_output", "name": "输出收口" }
  ],
  "variables": [
    { "key": "question", "type": "string" },
    { "key": "response", "type": "string" },
    { "key": "traceId", "type": "string" }
  ],
  "steps": [
    {
      "id": "receive_question",
      "title": "接收问题变量",
      "type": "input",
      "instruction": "把用户输入写入 question"
    },
    {
      "id": "generate_answer",
      "title": "大模型生成回答",
      "type": "llm",
      "prompt": "基于 question 生成 response",
      "next": "emit_output"
    },
    {
      "id": "emit_output",
      "title": "返回结果",
      "type": "output",
      "description": "输出 response 与 traceId"
    }
  ],
  "edges": [
    { "from": "receive_question", "to": "generate_answer" },
    { "from": "generate_answer", "to": "emit_output" }
  ]
}

